#!/bin/bash
# =============================================================================
# Debian Post-Removal Script (postrm)
# Guarantees the dynamic repo file is dropped to keep system APT layouts clean.
# =============================================================================
set -e

# -----------------------------------------------------------------------------
# DEBUG MODE TOGGLE
# Change to "true" to print extensive step-by-step diagnostic trace statements.
# -----------------------------------------------------------------------------
DEBUG="true"

# -----------------------------------------------------------------------------
# FUNCTION: log_debug()
# Prints detailed runtime information if DEBUG mode is enabled.
# -----------------------------------------------------------------------------
log_debug() {
    if [ "${DEBUG}" = "true" ]; then
        echo "[{{ package_name }}{{ package_suffix }}] $1"
    fi
}

# -----------------------------------------------------------------------------
# FUNCTION: purge_repository_configuration()
# Explicitly deletes the dynamic .sources target file from the system folder.
# -----------------------------------------------------------------------------
purge_repository_configuration() {
    TARGET_FILE="/etc/apt/sources.list.d/{{ package_name }}.sources"

    if [ -f "${TARGET_FILE}" ]; then
        log_debug "Removing orphan repository configuration file: ${TARGET_FILE}"
        rm -f "${TARGET_FILE}"
    else
        log_debug "Cleanup skipped: file ${TARGET_FILE} does not exist."
    fi
}

{#
    # shellcheck disable=all
#}
{% if dynamic_keyring %}
{#
    # shellcheck enable=all
#}
# ==============================================================================
# FUNCTION: purge_dynamic_keyring()
# Only injected if the keyring was downloaded out-of-band by the client.
# ==============================================================================
purge_dynamic_keyring() {
    TARGET_KEYRING="/usr/share/keyrings/{{ package_name }}-archive-keyring.gpg"
    if [ -f "${TARGET_KEYRING}" ]; then
        log_debug "Removing orphan dynamic keyring asset: ${TARGET_KEYRING}"
        rm -f "${TARGET_KEYRING}"
    fi
}
{#
    # shellcheck disable=all
#}
{% endif %}
{#
    # shellcheck enable=all
#}
# -----------------------------------------------------------------------------
# FUNCTION: main()
# Runs the core application logic
# -----------------------------------------------------------------------------
main() {

    # Wipe the file during standard removals or explicit system purging loops
    if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
        log_debug "Executing postrm cleanup logic for package: {{ package_name }}"
        purge_repository_configuration
        {#
            # shellcheck disable=all
        #}
        {% if dynamic_keyring %}
        purge_dynamic_keyring
        {% endif %}
        {#
            # shellcheck enable=all
        #}
        log_debug "Cleanup process wrapped up successfully."
    else
        log_debug "Skipping cleanup execution: step state '$1' does not alter file allocations."
    fi
}

# Pass all incoming command line execution arguments into the main controller
main "$@"

# DEBHELPER macro placeholder required for downstream package additions
#DEBHELPER#

exit 0
