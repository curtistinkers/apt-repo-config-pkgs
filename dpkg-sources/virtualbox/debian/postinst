#!/bin/bash
# =============================================================================
# Debian Post-Installation Script (postinst)
# Handles the dynamic generation of the deb822 APT repository source file.
# =============================================================================
set -e # Immediately exit if any command fails, ensuring safe executions.

# -----------------------------------------------------------------------------
# DEBUG MODE TOGGLE
# Change to "true" to print extensive step-by-step diagnostic trace statements.
# -----------------------------------------------------------------------------
DEBUG="true"

# -----------------------------------------------------------------------------
# FUNCTION: log_debug()
# Prints detailed runtime information if DEBUG mode is enabled.
# -----------------------------------------------------------------------------
log_debug() {
    if [ "${DEBUG}" = "true" ]; then
        echo "[virtualbox-repo-config] $1"
    fi
}

# ------------------------------------------------------------------------------
# FUNCTION: normalize_os_environment()
# Sources /etc/os-release and standardizes derivative systems back to their
# appropriate upstream distribution bases if required by this vendor.
# ------------------------------------------------------------------------------
normalize_os_environment() {
    log_debug "Sourcing host operating system configuration details..."

    # shellcheck disable=SC1091
    if [ -f /etc/os-release ]; then
        . /etc/os-release
    else
        echo "ERROR: /etc/os-release not found. Cannot determine distribution." >&2
        exit 1
    fi
    # shellcheck enable=all

    # Default fallback values assignment
    TARGET_DISTRO="${ID}"
    TARGET_CODENAME="${VERSION_CODENAME}"

    log_debug "Raw system detected - ID: ${ID}, CODENAME: ${VERSION_CODENAME}"

    # --------------------------------------------------------------------------
    # VENDOR NORMALIZATION INJECTION BLOCK
    # Dynamically generated by the Python engine depending on manifest needs.
    # --------------------------------------------------------------------------

    case "${ID}" in

        *)
            log_debug "No specific vendor mapping rules matched. Using default environment IDs."
            ;;
    esac



    log_debug "Normalized runtime targets - DIST: ${TARGET_DISTRO}, CODENAME: ${TARGET_CODENAME}"
}

# -----------------------------------------------------------------------------
# FUNCTION: generate_sources_file()
# Evaluates variables and writes out the modern deb822 source file.
# -----------------------------------------------------------------------------
generate_sources_file() {
    OUTPUT_PATH="/etc/apt/sources.list.d/virtualbox.sources"
    log_debug "Preparing to generate targeted repository configuration at: ${OUTPUT_PATH}"

    # Process template values passed down by the Python builder engine.
    # We substitute runtime ${DIST} and ${CODENAME} values securely via shell expansion.
    RAW_URI="https://download.virtualbox.org/virtualbox/debian"
    RAW_SUITE="${TARGET_CODENAME}"
    RAW_COMPONENTS="contrib"

    # Evaluate potential manifest variable tokens safely using standard eval
    eval EVAL_URI="\"${RAW_URI}\""
    eval EVAL_SUITE="\"${RAW_SUITE}\""
    eval EVAL_COMPONENTS="\"${RAW_COMPONENTS}\""

    log_debug "Writing evaluated deb822 configuration layout to disc..."

    # Generate the actual target file cleanly
    cat << EOF > "${OUTPUT_PATH}"
Types: deb
URIs: ${EVAL_URI}
Suites: ${EVAL_SUITE}
Components: ${EVAL_COMPONENTS}
Signed-By: /usr/share/keyrings/virtualbox-archive-keyring.gpg
EOF

    # Restrict permissions to match standard secure root layouts
    chmod 644 "${OUTPUT_PATH}"
    log_debug "Successfully finalized and secured: ${OUTPUT_PATH}"
}



# -----------------------------------------------------------------------------
# FUNCTION: main()
# Runs the core application logic
# -----------------------------------------------------------------------------
main() {
    # Debian passes "configure" as the first argument during standard installations

    if [ "$1" = "configure" ] || [ "$1" = "upgrade" ]; then
        log_debug "Executing postinst orchestration for package: virtualbox"
        normalize_os_environment
        
        
        
        generate_sources_file
        log_debug "Post-installation execution successfully wrapped up."
    else
        log_debug "Skipping orchestration: action stage '$1' does not require runtime generation."
    fi
}

# Pass all incoming command line execution arguments into the main controller
main "$@"

# DEBHELPER macro placeholder required for downstream package additions
#DEBHELPER#

exit 0